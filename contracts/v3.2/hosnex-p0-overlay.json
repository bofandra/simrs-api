        "properties": {
          "patientId": {
            "type": "string",
            "format": "uuid"
          },
          "serviceType": {
            "type": "string",
            "enum": [
              "RJ",
              "RI",
              "IGD"
            ]
          },
          "dateOfService": {
            "type": "string",
            "format": "date"
          },
          "referralNumber": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "responseSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eligibilityCheckId",
          "status",
          "checkedAt"
        ],
        "properties": {
          "eligibilityCheckId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "ELIGIBLE",
              "INELIGIBLE",
              "UNAVAILABLE"
            ]
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "responseExample": {
        "eligibilityCheckId": "11111111-1111-4111-8111-111111111111",
        "status": "ELIGIBLE",
        "checkedAt": "2026-11-14T09:00:00+07:00"
      },
      "successStatus": 201,
      "reviewRequired": true,
      "notes": "Do not claim an actual BPJS check until a real connector and legal eligibility rules exist"
    },
