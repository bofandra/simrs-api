      "requestSchema": null,
      "responseSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "practitionerId",
                "displayName"
              ],
              "properties": {
                "practitionerId": {
                  "type": "string",
                  "format": "uuid"
                },
                "displayName": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      },
      "responseExample": {
        "items": [
          {
            "practitionerId": "11111111-1111-4111-8111-111111111111",
            "displayName": "Dokter Demo"
          }
        ]
      },
      "successStatus": 200,
      "reviewRequired": true,
      "notes": "Use practitionerId rather than display name as foreign key; actual schedule filtering to review"
    },
